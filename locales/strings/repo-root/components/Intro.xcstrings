    "2: intro.tagline" : {
      "comment" : "If this text appears wider than the big 'Mac Mouse Fix' text right above, it will get clipped at certain window sizes. I think you can only figure this out while actually looking at the live website... So you should perhaps come back to this after your initial translations have been added to the live website... Or just leave it. I should make the layout code work with any text length. [Dec 2025]",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach deine $10 Maus besser als ein Apple Trackpad!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Make Your $10 Mouse Better Than an Apple Trackpad!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Haz Que Tu Ratón De $10 Sea Mejor Que Un Trackpad De Apple!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez votre souris à 10 $ meilleure qu'un trackpad Apple !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格安マウスで、Appleトラックパッドを超える体験を！"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraw by twoja myszka była lepsza niż gładzik od Apple!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe seu mouse de US$10 melhor que um Trackpad da Apple!"
          }
        },
        "ru" : {
