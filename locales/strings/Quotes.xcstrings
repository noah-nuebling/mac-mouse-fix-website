    "quotes.26" : {
      "comment" : " ",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem ich zu einer Maus gewechselt habe, habe ich Software wie SteerMouse ausprobiert, die viele Empfehlungen erhält und sogar kostenpflichtig ist, und letztendlich festgestellt, dass Mac Mouse Fix meine Bedürfnisse perfekt erfüllt, jedes Feature ist sehr nützlich und die Effizienz ist sehr gut!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After switching to a mouse, I tried software such as SteerMouse, which received many recommendations and even charges, and finally found that this software meets my needs perfectly, every feature is very useful, and the performance is very good!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de cambiar a un ratón, probé software como SteerMouse, que recibió muchas recomendaciones e incluso es de pago, y finalmente descubrí que este software satisface mis necesidades a la perfección, cada función es muy útil, ¡y el rendimiento es muy bueno!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスに切り替えてから、評判が良く有料のSteerMouse など様々なソフトウェアを試してみましたが、最終的にこのソフトが自分の需要に完璧に合っていると確信しました。すべての機能が非常に有益で、動作も非常に快適です！"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po przejściu na myszkę wypróbowałem oprogramowanie takie jak SteerMouse, które zebrało wiele rekomendacji, a nawet jest płatne, ale w końcu stwierdziłem, że ten program idealnie spełnia moje potrzeby. Każda funkcja jest bardzo użyteczna, a wydajność jest bardzo dobra!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de mudar para mouse, testei softwares como o SteerMouse, cheio de recomendações e até pago, e finalmente achei este que atende perfeitamente: cada recurso é útil e o desempenho é excelente!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После перехода на мышь я попробовал такие программы, как SteerMouse, которая получила много рекомендаций и даже отзывов, и в конце концов обнаружил, что эта программа идеально соответствует моим потребностям, каждая функция очень полезна, да и производительность у нее отличная!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fareye geçtikten sonra çok fazla iyi yorum alan SteerMouse gibi uygulamaları da denedim ama sonunda tam isteklerimi gerçekleştiren bir uygulama buldum. Her özellik çok işlevli ve performansı çok iyi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi chuyển sang chuột, tôi đã thử phần mềm như là SteerMouse, nhận đề xuất nhiều và còn có cả lệ phí nữa, và sau cùng là nhận thấy là phần mềm này đáp ứng nhu cầu của tôi hoàn hảo, mọi tính năng là rất hữu ích, và việc thực hiện là rất tốt! "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在换过来用鼠标后，我试过像SteerMouse这类好评颇多甚至需要付费的软件，最后发现这款软件完美满足了我的需求，每一项功能都非常实用，而且性能也十分出色！\n"
          }
        }
      }
    },
