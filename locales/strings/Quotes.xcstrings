            "value" : "Dein Werkzeug ist buchstäblich der einzige Weg, wie ich macOS (besonders mit einer Maus) verwenden kann, ohne auszuflippen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your tool is literally the only way how I can use macOS (with a mouse especially) without freaking out!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu herramienta es literalmente la única manera en que puedo usar macOS (especialmente con un ratón) ¡sin volverme loco!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このツールは、私がmacOS（特にマウスを使用する際）でイライラせずに操作できる、文字通り唯一の方法です！"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje narzędzie jest dosłownie jedynym sposobem, w jaki mogę używać macOS (zwłaszcza z myszką) bez spinania!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua ferramenta é literalmente o único jeito de eu usar macOS (especialmente com mouse) sem surtar!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш инструмент — это буквально единственный способ, с помощью которого я могу пользоваться macOS (особенно с мышью) и не сходить с ума!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama benim çıldırmadan macOS kullanmamı sağlayabilen tek uygulama (özellikle bir fare ile)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công cụ của bạn là cách duy nhất tôi có thể sử dụng macOS (với chuột) không có phản ứng mạnh mẽ ra! "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的工具简直是我能正常使用macOS（尤其是搭配鼠标使用时）而不抓狂的唯一办法！"
          }
        }
      }
    },
