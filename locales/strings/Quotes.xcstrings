    "quotes.thankyou" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Danke** an alle, die über die Jahre ihre Wertschätzung und ihr Feedback geteilt haben! Eure netten Nachrichten zu lesen ist immer motivierend **:)**"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Thank you** to everyone sharing their appreciation and feedback over the years! Reading your nice messages is always motivating **:)**"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡**Gracias** a todos los que han compartido su aprecio y comentarios a lo largo de los años! Leer sus bonitos mensajes siempre es motivador **:)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長年にわたり感謝の言葉やフィードバックを寄せてくださった皆さん、**ありがとうございます！** 皆さんからの温かいメッセージを読むたびに、いつも励みになっています**(^^)**"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dziękuję** wszystkim, którzy dzielą się swoją wdzięcznością i opiniami na przestrzeni lat! Czytanie twoich miłych wiadomości jest zawsze motywujące **:)**"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Obrigado** a todos que compartilharam carinho e feedback ao longo dos anos! Ler suas mensagens sempre motiva **:)**"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Спасибо** всем, кто на протяжении многих лет делился своими отзывами и благодарностями! Ваши приятные сообщения всегда мотивируют меня **:)**"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıllar boyu takdirleriniz ve geribildirimleriniz için herkese **teşekkürler**! İyi mesajlarınızı okumak her zaman motive edici. **:)**"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Cám ơn** mọi người đã chia sẻ cảm nhận và phản hồi trong những năm qua! Đọc những tin nhắn ấy luôn làm tôi có động lực hơn **:)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**十分感谢**多年来所有表达赞赏和给我反馈的所有人！读到你们的暖心留言，总能让我充满干劲**:)**"
          }
        }
      }
    },
