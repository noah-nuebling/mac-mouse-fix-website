    "quotes.6" : {
      "comment" : " ",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann mir nicht vorstellen, meinen Büro-Mac ohne diese Software zu verwenden. Ein echter Produktivitätsverstärker, gepaart mit meiner Evoluent-Vertikalmaus, für die es keinen Mac-Treiber gibt, wie es ihn für Windows gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cannot imagine using my office Mac without this software. Real productivity booster paired with my evoluent vertical mouse which does not have a driver for Mac like they do for Windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedo imaginar usar mi Mac de oficina sin este software. Un verdadero impulsor de la productividad emparejado con mi ratón vertical evoluent, que no tiene un controlador para Mac como sí lo tiene para Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このソフトなしで職場のMacを使うことなど想像もできません。Windows用にはドライバーがあるのにMac用にはない、私の Evoluentバーティカルマウスと組み合わせると、仕事の効率が劇的に上がります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wyobrażam sobie używania mojego Maca bez tego oprogramowania. Prawdziwy wzmacniacz produktywności w połączeniu z moją rewelacyjną pionową myszką, która nie ma sterownika dla komputerów Mac, tak jak w przypadku systemu Windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consigo imaginar usar meu Mac do trabalho sem este software. Aumenta mesmo a produtividade com meu mouse vertical Evoluent, que nem tem driver para Mac como tem para Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не могу представить, как я мог бы работать на своем офисном Mac без этого программного обеспечения. Оно значительно повышает производительность в сочетании с моей вертикальной мышью evoluent, для которой нет драйвера для Mac, как для Windows."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofisteki Mac'imi bu yazılım olmadan nasıl kullanırım bilmiyorum. Windows'da sürücüsü olup macOS'da olmayan dikey farem ile beraber muhteşem bir üretkenlik artırıcı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tưởng tượng dùng office Mac không có phần mềm này. Nó năng suất thực sự phối với chuột thẳng đứng evoluent của tôi mà không có phần mềm cho Mac như họ làm cho Windows. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真不敢想象在办公室用Mac的时候没有这款软件会是什么样子。我的Evoluent垂直鼠标根本不像他们为Windows系统编写驱动程序那样也给Mac编写一套驱动。而这款软件搭配我的鼠标使用，真的极大地提升了工作效率。"
          }
        }
      }
    },
