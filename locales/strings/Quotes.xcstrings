    "quotes.46" : {
      "comment" : " ",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für diese App, ich verstehe nicht, warum Apple das nicht zum Standard gemacht hat, es ist super intuitiv, Gesten mit dem Mittelklick zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thank you for this, i don't understand why apple didn't make this as default, like it's super intuitive doing gestures with the middle click."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por esto, no entiendo por qué Apple no hizo esto por defecto, ya que es súper intuitivo hacer gestos con el clic central."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありがとうございます。なぜAppleが最初から標準機能にしなかったのか理解できません。ホイールクリックを使ったジェスチャー操作はすごく直感的です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziękuję za tą aplikację. Nie rozumiem, dlaczego Apple nie zrobiło jej jako domyślnej, Lubię to super intuicyjne wykonywanie gestów środkowym kliknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por isso. Não entendo por que a Apple não fez algo assim nativamente; é super intuitivo fazer gestos com o clique do meio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за это, я не понимаю, почему Apple не сделала это по умолчанию, ведь выполнять жесты средней кнопкой мыши очень интуитивно понятно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun için teşekkürler, bunu Apple'ın neden varsayılan olarak getirmediğini anlamıyorum. Orta düğme ile hareketleri gerçekleştirebilmek çok sezgisel."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cám ơn bạn về chuyện này, tôi không hiểu tại sao Apple không làm điều này mặc định, như thể nó là siêu trực quan về cử chỉ với nút giữa. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢你做的这款软件，我真搞不懂苹果为什么不把这些功能设为默认，毕竟用中键进行手势操作是非常直观的啊。"
          }
        }
      }
    },
